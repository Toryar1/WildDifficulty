<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>fr.wilddifficulty</groupId>
    <artifactId>WildDifficulty</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>WildDifficulty</name>
    <description>Plugin de scaling de difficulté pour mobs vanilla selon biome, distance et zones.</description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Valeurs par défaut — surchargées par les profils -->
        <paper.api.version>26.2.build.0</paper.api.version>
        <jar.classifier>paper-26.2</jar.classifier>
    </properties>

    <!-- ═══════════════════════════════════════════════════════
         PROFILS DE VERSION — build avec: mvn package -P v1_19
         ═══════════════════════════════════════════════════════ -->
    <profiles>

        <!-- ── Paper 26.2 (actuel / défaut) ── -->
        <profile>
            <id>v26_2</id>
            <activation><activeByDefault>true</activeByDefault></activation>
            <properties>
                <paper.api.version>[26.2.build.0,)</paper.api.version>
                <jar.classifier>paper-26.2</jar.classifier>
            </properties>
        </profile>

        <!-- ── Paper 26.1 ── -->
        <profile>
            <id>v26_1</id>
            <properties>
                <paper.api.version>1.21.4-R0.1-SNAPSHOT</paper.api.version>
                <jar.classifier>paper-26.1</jar.classifier>
            </properties>
        </profile>

        <!-- ── Paper / Spigot 1.21 ── -->
        <profile>
            <id>v1_21</id>
            <properties>
                <paper.api.version>1.21.4-R0.1-SNAPSHOT</paper.api.version>
                <jar.classifier>paper-1.21</jar.classifier>
            </properties>
        </profile>

        <!-- ── Paper / Spigot 1.20.6 ── -->
        <profile>
            <id>v1_20_6</id>
            <properties>
                <paper.api.version>1.20.6-R0.1-SNAPSHOT</paper.api.version>
                <jar.classifier>paper-1.20.6</jar.classifier>
            </properties>
        </profile>

        <!-- ── Paper / Spigot 1.20 ── -->
        <profile>
            <id>v1_20</id>
            <properties>
                <paper.api.version>1.20.4-R0.1-SNAPSHOT</paper.api.version>
                <jar.classifier>paper-1.20</jar.classifier>
            </properties>
        </profile>

        <!-- ── Paper / Spigot 1.19 ── -->
        <profile>
            <id>v1_19</id>
            <properties>
                <paper.api.version>1.19.4-R0.1-SNAPSHOT</paper.api.version>
                <jar.classifier>paper-1.19</jar.classifier>
            </properties>
        </profile>

        <!-- ── Universal (1.19 à 26.2 Cross-Compatible) ── -->
        <profile>
            <id>universal</id>
            <properties>
                <paper.api.version>1.19.4-R0.1-SNAPSHOT</paper.api.version>
                <jar.classifier>1.19-26.2-Universal</jar.classifier>
            </properties>
        </profile>

    </profiles>

    <repositories>
        <!-- Repository Paper -->
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <!-- Repository Citizens -->
        <repository>
            <id>citizens-repo</id>
            <url>https://maven.citizensnpcs.co/repo</url>
        </repository>
        <!-- Repository PlaceholderAPI -->
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>
        <!-- Repository bStats -->
        <repository>
            <id>bstats-repo</id>
            <url>https://repo.codemc.org/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper API — version contrôlée par le profil actif -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.api.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Citizens API (optionnel) -->
        <dependency>
            <groupId>net.citizensnpcs</groupId>
            <artifactId>citizens-main</artifactId>
            <version>2.0.35-SNAPSHOT</version>
            <type>jar</type>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- PlaceholderAPI (optionnel) -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>

        <!-- bStats Metrics -->
        <dependency>
            <groupId>org.bstats</groupId>
            <artifactId>bstats-bukkit</artifactId>
            <version>3.0.2</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compilation Java 21 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- Plugin Shade : embarque bStats et repackage -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <finalName>WildDifficulty-${jar.classifier}-${project.version}</finalName>
                            <relocations>
                                <!-- Repackage bStats pour éviter les conflits -->
                                <relocation>
                                    <pattern>org.bstats</pattern>
                                    <shadedPattern>fr.wilddifficulty.libs.bstats</shadedPattern>
                                </relocation>
                            </relocations>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Antrun : nettoie et copie le JAR vers le serveur de test -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <delete quiet="true">
                                    <fileset dir="${project.build.directory}" includes="original-*.jar"/>
                                </delete>
                                <copy file="${project.build.directory}/WildDifficulty-${jar.classifier}-${project.version}.jar"
                                      tofile="C:/Users/Arthur/Desktop/Serveur de test/plugins/WildDifficulty-${jar.classifier}-${project.version}.jar"
                                      failonerror="false"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <!-- Inclure les ressources dans le JAR -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>
</project>
